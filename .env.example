# Copy this file to .env and fill in your Supabase project's values.
# Only the URL and the PUBLIC anon key belong here — Vite exposes every
# VITE_-prefixed variable to the browser bundle. NEVER put the service_role
# key or any other secret in a VITE_ variable.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# --------------------------------------------------------------------------
# The following are NOT read by the frontend. They're Edge Function secrets,
# set with the Supabase CLI, not in this file:
#
#   supabase secrets set WEBAUTHN_RP_ID=your-production-domain.com
#   supabase secrets set WEBAUTHN_ORIGIN=https://your-production-domain.com
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically into
# every Edge Function — you don't set those yourself.
# --------------------------------------------------------------------------
